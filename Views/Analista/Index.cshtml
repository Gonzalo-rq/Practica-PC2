@model IEnumerable<CreditosApp.Models.SolicitudCredito>

@{
    ViewData["Title"] = "Panel de Evaluación - Analista de Riesgo";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-shield-check text-warning"></i> Panel de Evaluación de Solicitudes</h2>
        <span class="badge bg-primary fs-6">Rol: Analista</span>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Solicitudes Pendientes de Evaluación</h5>
            <span class="badge bg-warning text-dark">@Model.Count() pendientes</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-secondary">
                        <tr>
                            <th>#ID</th>
                            <th>Cliente</th>
                            <th>Ingresos Mensuales</th>
                            <th>Monto Solicitado</th>
                            <th>Capacidad (Máx 5x)</th>
                            <th>Fecha</th>
                            <th class="text-center">Decisión</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var s in Model)
                            {
                                var limiteAprobacion = (s.Cliente?.IngresosMensuales ?? 0) * 5;
                                var esAprobable = s.MontoSolicitado <= limiteAprobacion;

                                <tr>
                                    <td><strong>#@s.Id</strong></td>
                                    <td>
                                        <div>@(s.Cliente?.Usuario?.Email ?? "N/A")</div>
                                        <small class="text-muted">ID Cliente: @s.ClienteId</small>
                                    </td>
                                    <td>@s.Cliente?.IngresosMensuales.ToString("C")</td>
                                    <td class="fw-bold @(esAprobable ? "text-dark" : "text-danger")">
                                        @s.MontoSolicitado.ToString("C")
                                    </td>
                                    <td>
                                        <span class="badge @(esAprobable ? "bg-info text-dark" : "bg-danger")">
                                            Hasta @limiteAprobacion.ToString("C")
                                        </span>
                                    </td>
                                    <td>@s.FechaSolicitud.ToLocalTime().ToString("g")</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <!-- Formulario de Aprobación -->
                                            <form asp-action="Aprobar" method="post" class="d-inline" onsubmit="return confirm('¿Confirmas la APROBACIÓN de la solicitud #@s.Id?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@s.Id" />
                                                <button type="submit" class="btn btn-sm btn-success" title="@(!esAprobable ? "Supera el límite de 5x ingresos" : "Aprobar solicitud")">
                                                    <i class="bi bi-check-lg"></i> Aprobar
                                                </button>
                                            </form>

                                            <!-- Botón para abrir modal de Rechazo -->
                                            <button type="button" class="btn btn-sm btn-danger ms-1" data-bs-toggle="modal" data-bs-target="#modalRechazo-@s.Id">
                                                <i class="bi bi-x-lg"></i> Rechazar
                                            </button>
                                        </div>

                                        <!-- Modal de Rechazo -->
                                        <div class="modal fade" id="modalRechazo-@s.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content text-start">
                                                    <form asp-action="Rechazar" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@s.Id" />
                                                        <div class="modal-header bg-danger text-white">
                                                            <h5 class="modal-title">Rechazar Solicitud #@s.Id</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p><strong>Cliente:</strong> @(s.Cliente?.Usuario?.Email ?? "N/A")</p>
                                                            <p><strong>Monto:</strong> @s.MontoSolicitado.ToString("C")</p>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Motivo de Rechazo <span class="text-danger">*</span>:</label>
                                                                <textarea name="motivoRechazo" class="form-control" rows="3" required placeholder="Especifique la justificación del rechazo (ej. capacidad de endeudamiento excedida)..."></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                            <button type="submit" class="btn btn-danger">Confirmar Rechazo</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                    No hay solicitudes pendientes de evaluación en este momento.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
