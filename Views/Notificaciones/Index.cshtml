@model IEnumerable<CreditosApp.Models.Notificacion>

@{
    ViewData["Title"] = "Mis Notificaciones";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-bell text-primary"></i> Mis Notificaciones</h2>
        <span class="badge bg-secondary fs-6">Cloud MQ (RabbitMQ)</span>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Historial de Notificaciones de Recepción</h5>
            <span class="badge bg-info text-dark">@Model.Count() recibidas</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-secondary">
                        <tr>
                            <th>#ID</th>
                            <th>Solicitud</th>
                            <th>Notificación</th>
                            <th>Fecha de Procesamiento</th>
                            <th>UUID (MessageId)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var n in Model)
                            {
                                <tr>
                                    <td><strong>#@n.Id</strong></td>
                                    <td>
                                        <a asp-controller="Solicitudes" asp-action="Detalle" asp-route-id="@n.SolicitudId" class="fw-bold text-decoration-none">
                                            Solicitud #@n.SolicitudId
                                        </a>
                                    </td>
                                    <td>
                                        <span class="text-dark">
                                            <i class="bi bi-chat-left-dots text-primary me-1"></i> @n.Texto
                                        </span>
                                    </td>
                                    <td>
                                        <div>@n.FechaProcesamientoUtc.ToLocalTime().ToString("g")</div>
                                        <small class="text-muted">UTC: @n.FechaProcesamientoUtc.ToString("u")</small>
                                    </td>
                                    <td>
                                        <code class="text-muted small">@n.MessageId</code>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    <i class="bi bi-bell-slash fs-3 d-block mb-2"></i>
                                    Aún no tienes notificaciones de recepción procesadas por Cloud MQ.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
