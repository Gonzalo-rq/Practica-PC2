@model CreditosApp.Models.SolicitudCredito

@{
    ViewData["Title"] = $"Detalle de Solicitud #{Model.Id}";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Solicitud de Crédito #@Model.Id</h4>
                    <span id="detalle-badge" class="badge @(Model.Estado == CreditosApp.Models.EstadoSolicitud.Aprobado ? "bg-success" : Model.Estado == CreditosApp.Models.EstadoSolicitud.Rechazado ? "bg-danger" : "bg-warning text-dark") fs-6">
                        @Model.Estado
                    </span>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-5 text-muted">Cliente:</div>
                        <div class="col-sm-7 fw-bold">@(Model.Cliente?.Usuario?.Email ?? "N/A")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-5 text-muted">Ingresos Mensuales:</div>
                        <div class="col-sm-7">@(Model.Cliente?.IngresosMensuales.ToString("C") ?? "N/A")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-5 text-muted">Monto Solicitado:</div>
                        <div class="col-sm-7 text-primary fs-5 fw-bold">@Model.MontoSolicitado.ToString("C")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-5 text-muted">Fecha de Solicitud:</div>
                        <div class="col-sm-7">@Model.FechaSolicitud.ToLocalTime().ToString("f")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-5 text-muted">Estado Actual:</div>
                        <div class="col-sm-7 fw-bold" id="detalle-estado-texto">@Model.Estado</div>
                    </div>

                    <div id="detalle-motivo-container" class="row mb-3 @(string.IsNullOrEmpty(Model.MotivoRechazo) ? "d-none" : "")">
                        <div class="col-sm-5 text-danger fw-bold">Motivo de Rechazo:</div>
                        <div class="col-sm-7 text-danger" id="detalle-motivo-texto">@Model.MotivoRechazo</div>
                    </div>
                </div>
                <div class="card-footer bg-light d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Volver a Mis Solicitudes
                    </a>
                    @if (User.IsInRole("Analista"))
                    {
                        <a asp-controller="Analista" asp-action="Index" class="btn btn-outline-primary">
                            Ir al Panel de Analista
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
